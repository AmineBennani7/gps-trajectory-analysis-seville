# Copy to .env and change the password. .env is ignored by git.
# Used by docker-compose.yml for the PostGIS container and by the app.
POSTGRES_USER=gps
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gps
POSTGRES_PORT=5432

# Connection string for the app when it runs on your machine.
# Inside docker compose the app uses the host "db" (set in docker-compose.yml).
# Leave empty to run without a database.
DATABASE_URL=postgresql+psycopg://gps:change-me@localhost:5432/gps

# DEBUG, INFO, WARNING
GPS_LOG_LEVEL=INFO
